{
  "info": {
    "name": "backendUpb - Productos",
    "description": "CRUD de productos (Express + PostgreSQL) desplegado en Render.\n\nCambia la variable `baseUrl` para usar local o producción.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://backendupbtest.onrender.com",
      "description": "Producción (Render)"
    },
    {
      "key": "localUrl",
      "value": "http://localhost:3000",
      "description": "Local: copia este valor en baseUrl para probar en tu PC"
    },
    {
      "key": "id",
      "value": "2",
      "description": "Id del producto a consultar, actualizar o eliminar"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      }
    },
    {
      "name": "Estado del servicio (commit desplegado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200 y estado ok\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().estado).to.eql(\"ok\");",
              "});",
              "pm.test(\"Base de datos conectada\", function () {",
              "    pm.expect(pm.response.json().baseDeDatos).to.eql(\"conectada\");",
              "});",
              "// En Render el commit coincide con el último push a main",
              "console.log(\"Commit desplegado:\", pm.response.json().commit);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/estado",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estado"
          ]
        },
        "description": "Health check con la base de datos y el commit que corre en el servidor. Sirve para comprobar que un push a main se desplegó solo en Render."
      }
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "Buscar productos por nombre",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/productos?nombre=prueba",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ],
          "query": [
            {
              "key": "nombre",
              "value": "prueba",
              "description": "Texto a buscar (no distingue mayúsculas)"
            }
          ]
        }
      }
    },
    {
      "name": "Obtener producto por id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('id', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Laptop\",\n    \"precio\": 1500,\n    \"stock\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"precio\": 1350,\n    \"stock\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Eliminar producto",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Crear producto inválido (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"precio\": -10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    }
  ]
}
