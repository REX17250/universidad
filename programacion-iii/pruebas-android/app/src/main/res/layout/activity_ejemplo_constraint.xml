<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EjemploConstraintActivity">

    <TextView
        android:id="@+id/textview_ejemplo1"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="50sp"
        android:background="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="150dp"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="400dp"
        android:background="#FF0000"
        />

    <TextView
        android:id="@+id/textview_ejemplo2"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="2"
        android:textColor="@color/white"
        android:textSize="60sp"
        android:background="@color/black"
        app:layout_constraintStart_toEndOf="@+id/textview_ejemplo1"
        android:layout_marginEnd="150dp"
        app:layout_constraintTop_toBottomOf="@+id/textview_ejemplo1"
        />
    <TextView
        android:id="@+id/textview_ejemplo3"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="3"
        android:textColor="@color/white"
        android:textSize="60sp"
        android:background="@color/black"
        app:layout_constraintStart_toEndOf="@+id/textview_ejemplo2"
        android:layout_marginEnd="150dp"
        app:layout_constraintTop_toBottomOf="@+id/textview_ejemplo2"
        />

    <TextView
        android:id="@+id/textview_ejemplo4"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:text="4"
        android:textColor="@color/white"
        android:textSize="50sp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/textview_ejemplo3"
        app:layout_constraintEnd_toStartOf="@+id/textview_ejemplo3"
        />

    <TextView
        android:id="@+id/textview_ejemplo5"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:text="5"
        android:textColor="@color/white"
        android:textSize="50sp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/textview_ejemplo4"
        app:layout_constraintEnd_toStartOf="@+id/textview_ejemplo4"
        />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:weightSum="100"
        android:elevation="2dp"
        tools:context=".MainActivity"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBaseline_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/black"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/black"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/black"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/black"
                />
        </LinearLayout>

        
    </LinearLayout>
        


    


</androidx.constraintlayout.widget.ConstraintLayout>