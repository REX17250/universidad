<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".interaccionesDeVistasActivity">

    <ImageView
        android:id="@+id/imageview_ejemplo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/accelerate_svgrepo_com"/>

    <ImageView
        android:id="@+id/imageview_ejemplo_2"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher_round"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imageview_ejemplo_3"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:scaleType="fitCenter"
            android:src="@drawable/accelerate_svgrepo_com"
            app:layout_constraintDimensionRatio="1:2"
            app:layout_constraintHorizontal_bias="0.2"
            app:flow_firstVerticalBias="0.4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <ImageView
            android:id="@+id/imageview_ejemplo_4"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintEnd_toStartOf="@id/guideline_ejemplo_vertical"
            app:layout_constraintBottom_toBottomOf="@id/guideline_ejemplo_horizontal"
            android:src="@mipmap/ic_launcher_round"/>
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ejemplo_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="150dp"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_ejemplo_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="100dp"
            app:layout_constraintGuide_percent="0.32"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imageview_ejemplo_5"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher_round"/>
            <ImageView
                android:id="@+id/imageview_ejemplo_6"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher_round"/>
            <ImageView
                android:id="@+id/imageview_ejemplo_7"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher_round"/>
            <ImageView
                android:id="@+id/imageview_ejemplo_8"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher_round"/>
            <ImageView
                android:id="@+id/imageview_ejemplo_9"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher_round"/>
        </LinearLayout>
    </ScrollView>
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/imageview_ejemplo_10"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher_round"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>